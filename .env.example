# Local development only. Choose two different strong passwords, URI-encode in URLs.
POSTGRES_PASSWORD=replace-migration-password
PAPBOX_DB_PASSWORD=replace-application-password
POSTGRES_PORT=5432
DATABASE_MIGRATION_URL=postgresql://papbox_migrator:replace-migration-password@127.0.0.1:5432/papbox
DATABASE_URL=postgresql://papbox_app:replace-application-password@127.0.0.1:5432/papbox
# Optional reviewed public-key registry; unset means no external publisher trusted.
# PAPBOX_TRUSTED_KEYS=/absolute/path/to/trusted-publishers.json
# MFA: set a private 32-byte hex key, identical across instances; preserve with backups.
# PAPBOX_ENCRYPTION_KEY=
# MCP: private current-user-owned mode 0600 file, generated with session:create.
# PAPBOX_MCP_SESSION_FILE=/secure/path/papbox-session
# Email recovery (disabled until configured and verified); see docs/GOOGLE-WORKSPACE.md.
# Requires PostgreSQL, PAPBOX_ENCRYPTION_KEY and a separate mail:worker process.
PAPBOX_EMAIL_ENABLED=false
# PAPBOX_PUBLIC_URL=https://app.example.com
# GOOGLE_MAIL_CLIENT_ID=
# GOOGLE_MAIL_CLIENT_SECRET=
# GOOGLE_MAIL_REFRESH_TOKEN=
# GOOGLE_MAIL_FROM=
# SSO is deferred; these are reserved setup values, not consumed by runtime yet.
# GOOGLE_SSO_CLIENT_ID=
# GOOGLE_SSO_CLIENT_SECRET=
# GOOGLE_WORKSPACE_DOMAIN=
# GOOGLE_SSO_REDIRECT_URI=https://app.example.com/api/auth/google/callback
