# Local development only. Choose two different strong passwords, URI-encode in URLs.
POSTGRES_PASSWORD=replace-migration-password
PAPBOX_DB_PASSWORD=replace-application-password
POSTGRES_PORT=5432
DATABASE_MIGRATION_URL=postgresql://papbox_migrator:replace-migration-password@127.0.0.1:5432/papbox
DATABASE_URL=postgresql://papbox_app:replace-application-password@127.0.0.1:5432/papbox
# Optional reviewed public-key registry; unset means no external publisher trusted.
# PAPBOX_TRUSTED_KEYS=/absolute/path/to/trusted-publishers.json
